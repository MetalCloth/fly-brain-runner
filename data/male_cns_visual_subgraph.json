    "types": [
      "R1-R6",
      "L1",
      "L2",
      "L3",
      "DNc01",
      "DNc02"
    ],
    "reason": "A deliberately small visual-to-descending slice: R1-R6 is the visual input class, L1/L2/L3 are optic-lobe intrinsic types, and DNc01/DNc02 are descending output types.",
    "aggregation": "one node per published neuron type; edges are summed by type pair"
  },
  "queries": {
    "nodes": "MATCH (n:Neuron)\nWHERE n.type IN ['R1-R6', 'L1', 'L2', 'L3', 'DNc01', 'DNc02']\nRETURN n.type AS type,\n       n.superclass AS superclass,\n       n.class AS neuron_class,\n       count(n) AS neuron_count,\n       sum(n.pre) AS total_pre,\n       sum(n.post) AS total_post\nORDER BY type",
    "edges": "MATCH (a:Neuron)-[c:ConnectsTo]->(b:Neuron)\nWHERE a.type IN ['R1-R6', 'L1', 'L2', 'L3', 'DNc01', 'DNc02'] AND b.type IN ['R1-R6', 'L1', 'L2', 'L3', 'DNc01', 'DNc02']\nRETURN a.type AS upstream_type,\n       b.type AS downstream_type,\n       sum(c.weight) AS total_weight,\n       count(*) AS body_edges\nORDER BY upstream_type, total_weight DESC, downstream_type"
  },
